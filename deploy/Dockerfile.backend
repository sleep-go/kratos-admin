FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api ./api
COPY app ./app
COPY migrations ./migrations
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/kratos-admin ./app/admin/cmd/server
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/kratos-admin-tools ./app/admin/cmd/tools

FROM alpine:3.22 AS runtime
RUN addgroup -S kratos && adduser -S kratos -G kratos
WORKDIR /app
COPY --from=build /out/kratos-admin /usr/local/bin/kratos-admin
COPY --from=build /out/kratos-admin-tools /usr/local/bin/kratos-admin-tools
COPY configs ./configs
USER kratos

FROM runtime AS admin-server
EXPOSE 8000 9000
ENTRYPOINT ["kratos-admin"]
CMD ["-conf", "/app/configs/config.docker.yaml"]

FROM runtime AS init-admin
ENTRYPOINT ["kratos-admin-tools"]
CMD ["init-admin", "--conf", "/app/configs/config.docker.yaml"]
