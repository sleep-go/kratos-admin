FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api ./api
COPY app ./app
COPY internal ./internal
COPY migrations ./migrations
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/kratos-admin ./app/admin/cmd/kratos-admin

FROM alpine:3.22 AS runtime
RUN addgroup -S kratos && adduser -S kratos -G kratos
WORKDIR /app
COPY --from=build /out/kratos-admin /usr/local/bin/kratos-admin
COPY configs ./configs
USER kratos
ENTRYPOINT ["kratos-admin"]

FROM runtime AS admin-server
EXPOSE 8000 9000
CMD ["server", "--conf", "/app/configs/config.docker.yaml"]

FROM runtime AS init-admin
CMD ["init-admin", "--conf", "/app/configs/config.docker.yaml"]
