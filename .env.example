KRATOS_ADMIN_ENV=development
KRATOS_ADMIN_HTTP_ADDR=:8000
KRATOS_ADMIN_GRPC_ADDR=:9000
KRATOS_ADMIN_MYSQL_DSN=kratos:kratos@tcp(mysql:3306)/kratos_admin?charset=utf8mb4&parseTime=True&loc=Local
KRATOS_ADMIN_REDIS_ADDR=redis:6379
KRATOS_ADMIN_MYSQL_PORT=3306
KRATOS_ADMIN_REDIS_PORT=6379
KRATOS_ADMIN_SECRET_KEY=replace-with-exactly-32-bytes-key
KRATOS_ADMIN_JWT_PRIVATE_KEY=
KRATOS_ADMIN_INITIAL_ADMIN_PASSWORD=
KRATOS_ADMIN_STORAGE_PROVIDER=local
KRATOS_ADMIN_STORAGE_LOCAL_PATH=/data/files
KRATOS_ADMIN_STORAGE_MAX_FILE_SIZE=104857600

# 阿里云 OSS（启用 aliyun-oss Provider 时配置）
KRATOS_ADMIN_OSS_REGION=
KRATOS_ADMIN_OSS_ENDPOINT=
KRATOS_ADMIN_OSS_BUCKET=
KRATOS_ADMIN_OSS_ACCESS_KEY_ID=
KRATOS_ADMIN_OSS_ACCESS_KEY_SECRET=
KRATOS_ADMIN_OSS_SECURITY_TOKEN=
