KRATOS_ADMIN_ENV=development
KRATOS_ADMIN_HTTP_ADDR=:8000
KRATOS_ADMIN_GRPC_ADDR=:9000
KRATOS_ADMIN_MYSQL_DSN=kratos:kratos@tcp(mysql:3306)/kratos_admin?charset=utf8mb4&parseTime=True&loc=Local
KRATOS_ADMIN_REDIS_ADDR=redis:6379
KRATOS_ADMIN_REDIS_DB=0
KRATOS_ADMIN_ACCESS_TTL=900s
KRATOS_ADMIN_REFRESH_TTL=604800s
KRATOS_ADMIN_MYSQL_PORT=3306
KRATOS_ADMIN_REDIS_PORT=6379
KRATOS_ADMIN_HTTP_PORT=8000
KRATOS_ADMIN_GRPC_PORT=9000
KRATOS_ADMIN_FRONTEND_PORT=8080
KRATOS_ADMIN_MAILPIT_PORT=8025
KRATOS_ADMIN_SECRET_KEY=0123456789abcdef0123456789abcdef
KRATOS_ADMIN_JWT_PRIVATE_KEY=
KRATOS_ADMIN_INITIAL_ADMIN_PASSWORD=replace-with-at-least-12-characters

# 本地 compose 使用 Mailpit；生产替换为真实 SMTP
KRATOS_ADMIN_SMTP_ADDRESS=mailpit:1025
KRATOS_ADMIN_SMTP_HOST=mailpit
KRATOS_ADMIN_SMTP_USERNAME=
KRATOS_ADMIN_SMTP_PASSWORD=
KRATOS_ADMIN_SMTP_FROM=kratos-admin@example.local
KRATOS_ADMIN_SMTP_USE_TLS=false

# 阿里云短信（配置 AccessKey ID 后启用；连接测试只查询签名，不发送短信）
KRATOS_ADMIN_ALIYUN_SMS_REGION=cn-hangzhou
KRATOS_ADMIN_ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
KRATOS_ADMIN_ALIYUN_SMS_ACCESS_KEY_ID=
KRATOS_ADMIN_ALIYUN_SMS_ACCESS_KEY_SECRET=
KRATOS_ADMIN_ALIYUN_SMS_SIGN_NAME=
KRATOS_ADMIN_ALIYUN_SMS_TEMPLATE_CODE=

KRATOS_ADMIN_STORAGE_PROVIDER=local
KRATOS_ADMIN_STORAGE_LOCAL_PATH=/data/files
KRATOS_ADMIN_STORAGE_MAX_FILE_SIZE=104857600

# 阿里云 OSS（启用 aliyun-oss Provider 时配置）
KRATOS_ADMIN_OSS_REGION=
KRATOS_ADMIN_OSS_ENDPOINT=
KRATOS_ADMIN_OSS_BUCKET=
KRATOS_ADMIN_OSS_ACCESS_KEY_ID=
KRATOS_ADMIN_OSS_ACCESS_KEY_SECRET=
KRATOS_ADMIN_OSS_SECURITY_TOKEN=
